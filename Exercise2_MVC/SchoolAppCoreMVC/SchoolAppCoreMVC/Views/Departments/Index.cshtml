
@model IEnumerable<SchoolAppCoreMVC.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<h1>Department Management</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Department Name</th>
            <th>Budget</th>
            <th>Start Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DepartmentName</td>
                <td>@item.Budget</td>
                <td>@item.StartDate</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.DepartmentID">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.DepartmentID">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.DepartmentID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
